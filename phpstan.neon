includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    level: 8

    bootstrapFiles:
        - tests/phpstan-bootstrap.php

    paths:
        - app/
        - bootstrap/app.php
        - bootstrap/providers.php
        - config/
        - database/
        - routes/
        - tests/

    tmpDir: storage/framework/cache/phpstan
